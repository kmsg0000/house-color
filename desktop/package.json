{
  "name": "house-color",
  "productName": "우리집 외벽 색 바꾸기",
  "version": "1.0.0",
  "description": "건물 사진에 노루페인트 색을 칠해 보는 프로그램",
  "main": "main.js",
  "author": "house-color",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "kr.housecolor.app",
    "productName": "우리집 외벽 색 바꾸기",
    "artifactName": "HouseColor-Setup-${version}.${ext}",
    "files": ["main.js", "preload.js", "siwc.js", "comfy.js", "relay.js", "app/**/*", "icon.png"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "우리집 외벽 색 바꾸기"
    },
    "mac": { "target": "dmg", "icon": "icon.png", "category": "public.app-category.graphics-design" },
    "linux": { "target": "AppImage", "icon": "icon.png" }
  }
}
